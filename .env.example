# Kopieren nach .env.local und ausfüllen. .env.local wird nicht committed.
# KEINE echten Keys in diese Datei schreiben.

NEXT_PUBLIC_APP_NAME=Förde Sparkasse Wissensassistent
NEXT_PUBLIC_INTERNAL_POC=true

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig! Umgeht RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider ------------------------------------------------------------
# anymize | mock   (mock = technische Testantworten ohne API-Key, keine Fachinhalte;
#                   mit mock RAG_MIN_SIMILARITY/CORRECTION_MIN_SIMILARITY auf ca. 0.1 senken)
AI_PROVIDER=anymize

ANYMIZE_API_BASE_URL=https://app.anymize.ai/api/v1/llm
ANYMIZE_ANONYMOUS_API_BASE_URL=https://app.anymize.ai/api/v1/llm-anonymous

# Nur serverseitig! Niemals als NEXT_PUBLIC_* anlegen.
ANYMIZE_API_KEY=

# true  → Chat über /llm-anonymous (personenbezogene Daten werden vor dem Modell maskiert)
# false → Chat über /llm
ANYMIZE_USE_ANONYMIZATION=true

# Modell-ID aus GET /api/v1/llm/models (npm run ai:check listet sie).
ANYMIZE_CHAT_MODEL=
# Für RAG niedrig halten (0.0–0.2).
ANYMIZE_CHAT_TEMPERATURE=0.1
ANYMIZE_CHAT_MAX_TOKENS=1200
# response_format=json_object anfordern (auf false setzen, falls das gewählte Modell es nicht unterstützt).
ANYMIZE_JSON_MODE=true

# Embedding-Modell-ID (laut anymize-Doku aktuell "voyage-4-lite"; per `npm run ai:check` prüfen).
ANYMIZE_EMBEDDING_MODEL=
# WICHTIG: Muss exakt der vector(N)-Dimension in supabase/migrations/002_vector_search.sql entsprechen.
# Wird als output_dimension an die API gesendet. Änderung => `npm run db:vector-migration` + alles neu einbetten.
# Siehe docs/EMBEDDINGS.md.
ANYMIZE_EMBEDDING_DIMENSION=1024
ANYMIZE_EMBEDDING_BATCH_SIZE=64

ANYMIZE_TIMEOUT_MS=30000
ANYMIZE_MAX_RETRIES=2

# --- RAG ----------------------------------------------------------------------
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.55
RAG_MAX_CHUNKS_PER_SOURCE=2
RAG_MAX_CONTEXT_CHARS=12000
CORRECTION_TOP_K=5
CORRECTION_MIN_SIMILARITY=0.6

# --- Crawler ----------------------------------------------------------------
CRAWL_ALLOWED_HOST=www.foerde-sparkasse.de
CRAWL_MAX_PAGES=150
CRAWL_USER_AGENT=FoerdeSparkasseInternalPOC/0.1

ADMIN_SHARED_SECRET=
LOG_LEVEL=info
